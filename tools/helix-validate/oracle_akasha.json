      },
      "source_snippet": "static HMODULE sv1(PPEB peb, uint64_t target) {\n    if (!peb || !peb->Ldr) return nullptr;\n    PLIST_ENTRY head = &peb->Ldr->InMemoryOrderModuleList;\n    for (PLIST_ENTRY cur = head->Flink; cur != head; cur = cur->Flink) {\n        PLDR_DATA_TABLE_ENTRY e = CONTAINING_RECORD(cur, LDR_DATA_TABLE_ENTRY, InMemoryOrderLinks);\n        if (!e->FullDllName.Buffer || e->FullDllName.Length < 2) continue;\n\n        char name[96]; size_t i = 0;\n        WCHAR* w = e->FullDllName.Buffer;\n        size_t wlen = e->FullDllName.Length / 2;\n        size_t start = 0;\n        for (size_t k = 0; k < wlen; ++k) if (w[k] == L'\\\\' || w[k] == L'/') start = k + 1;\n        for (size_t k = start; k < wlen && i + 1 < sizeof(name); ++k) {\n            char c = static_cast<char>(w[k]);\n            if (c >= 'A' && c <= 'Z') c += 32;\n            name[i++] = c;\n        }\n        name[i] = 0;\n\n        if (rt_fnv(name) == target) return reinterpret_cast<HMODULE>(e->DllBase);\n    }\n    return nullptr;\n}",
