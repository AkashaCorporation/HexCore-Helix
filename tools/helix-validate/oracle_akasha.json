      "source_snippet": "static uint64_t rt_fnv(const char* s) {\n    constexpr uint32_t M = 0xA5A5A5A5;\n    volatile uint32_t oh = 0xCBF29CE4 ^ M;\n    volatile uint32_t ol = 0x84222325 ^ M;\n    volatile uint32_t ph = 0x00000100 ^ M;\n    volatile uint32_t pl = 0x000001B3 ^ M;\n\n    uint64_t h     = (static_cast<uint64_t>(oh ^ M) << 32) | (ol ^ M);\n    uint64_t prime = (static_cast<uint64_t>(ph ^ M) << 32) | (pl ^ M);\n\n    while (*s) { h = (h ^ static_cast<uint8_t>(*s++)) * prime; }\n    return h;\n}",
