      "source_snippet": "static FARPROC sv2(HMODULE mod, uint64_t target) {\n    if (!mod) return nullptr;\n    auto dos = reinterpret_cast<PIMAGE_DOS_HEADER>(mod);\n    if (dos->e_magic != IMAGE_DOS_SIGNATURE) return nullptr;\n    auto nt = reinterpret_cast<PIMAGE_NT_HEADERS>(reinterpret_cast<BYTE*>(mod) + dos->e_lfanew);\n    if (nt->Signature != IMAGE_NT_SIGNATURE) return nullptr;\n\n    DWORD rva = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress;\n    if (!rva) return nullptr;\n    auto exp = reinterpret_cast<PIMAGE_EXPORT_DIRECTORY>(reinterpret_cast<BYTE*>(mod) + rva);\n\n    auto names = reinterpret_cast<DWORD*>(reinterpret_cast<BYTE*>(mod) + exp->AddressOfNames);\n    auto ords  = reinterpret_cast<WORD*>(reinterpret_cast<BYTE*>(mod) + exp->AddressOfNameOrdinals);\n    auto funcs = reinterpret_cast<DWORD*>(reinterpret_cast<BYTE*>(mod) + exp->AddressOfFunctions);\n\n    for (DWORD i = 0; i < exp->NumberOfNames; ++i) {\n        const char* n = reinterpret_cast<const char*>(reinterpret_cast<BYTE*>(mod) + names[i]);\n        if (rt_fnv(n) == target) {\n            return reinterpret_cast<FARPROC>(reinterpret_cast<BYTE*>(mod) + funcs[ords[i]]);\n        }\n    }\n    return nullptr;\n}",
